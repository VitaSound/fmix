#!/usr/bin/env bash
# FMix launcher: restore the shell TTY after GForth exits.
: "${FMIX_HOME:=$HOME/fmix}"
GFORTH="${GFORTH:-gforth}"

# Same pattern as fhdl in ~/.bashrc: reset bracketed-paste before and after GForth.
printf '\033[?2004l' 2>/dev/null || true

if [ $# -eq 0 ]; then
    set -- help
fi

set +e
"$GFORTH" "$FMIX_HOME/fmix.4th" -e "$@"
status=$?
set -e

if [ -t 0 ]; then
    stty sane 2>/dev/null || true
    printf '\033[?2004l' >/dev/tty 2>/dev/null || true
else
    stty sane 2>/dev/null || true
    printf '\033[?2004l' 2>/dev/null || true
fi

exit "$status"
