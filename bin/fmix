#!/usr/bin/env bash
# FMix launcher: restore the shell TTY after GForth exits.
: "${FMIX_HOME:=$HOME/fmix}"
GFORTH="${GFORTH:-gforth}"

reset_tty() {
    local tty_path
    tty_path=$(tty 2>/dev/null || true)

    if [ -n "$tty_path" ] && [ "$tty_path" != "not a tty" ] && [ -r "$tty_path" ] && [ -w "$tty_path" ]; then
        stty sane < "$tty_path" 2>/dev/null || true
        printf '\033[?2004l' > "$tty_path" 2>/dev/null || true

        # WSL/Windows Terminal can leave terminal responses queued as input
        # (visible later as "0c" / "0c0c" at the next prompt).
        local _ch
        while IFS= read -r -s -t 0.02 -n 1 _ch < "$tty_path"; do
            :
        done
    else
        stty sane 2>/dev/null || true
        printf '\033[?2004l' 2>/dev/null || true
    fi
}

reset_tty

if [ $# -eq 0 ]; then
    FMIX_CMD=help
    FMIX_PARAM=
else
    FMIX_CMD=$1
    shift
    # Pre-parse `test` command flags so Forth side stays simple.
    # Recognised: --isolated (default), --shared.
    if [ "$FMIX_CMD" = "test" ]; then
        FMIX_TEST_ISOLATED=1
        while [ $# -gt 0 ]; do
            case "$1" in
                --isolated) FMIX_TEST_ISOLATED=1; shift ;;
                --shared)   FMIX_TEST_ISOLATED=0; shift ;;
                --)         shift; break ;;
                --*)
                    echo "[ERROR] Unknown test flag: $1" >&2
                    exit 1
                    ;;
                *) break ;;
            esac
        done
        export FMIX_TEST_ISOLATED
    fi
    FMIX_PARAM=$*
fi
export FMIX_CMD FMIX_PARAM

set +e
"$GFORTH" "$FMIX_HOME/fmix.4th"
status=$?
set -e

reset_tty

exit "$status"
